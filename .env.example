# Solo nombres y valores de ejemplo; los valores reales van en .env.local (no se sube) y en las variables de Vercel.
# Detalle y cómo probarlo: docs/I2-agente.md

# Proveedor del modelo (Muse Spark, de Meta). Hay dos; basta con la clave de uno.
#  - Meta (por defecto): clave creada SOLO para este proyecto en dev.meta.ai (con tope de gasto en Billing).
#  - Baseten (alternativa): clave de app.baseten.co; modelo Muse Spark Open (pesos abiertos).
# Sin AGENTE_PROVEEDOR: Meta si hay META_API_KEY; si no, Baseten si hay BASETEN_API_KEY. Sin ninguna clave, el agente responde 503 y la web usa el «Modo sin IA».
# Opcional: meta | baseten (fuerza uno; si falta su clave, el agente queda sin IA, no se pasa al otro).
# Ojo: los textos de privacidad de la web dicen «Meta». Si cambias a Baseten, cámbialos (PanelAgente.tsx, AcercaDe.tsx y Metodologia.tsx).
AGENTE_PROVEEDOR=
META_API_KEY=
# Opcional. Por defecto: muse-spark-1.3
META_MODEL=
# Opcional (pruebas con un servidor falso). Por defecto: https://api.meta.ai/v1
META_API_BASE_URL=
BASETEN_API_KEY=
# Opcional. Por defecto: meta-models/muse-spark-open (el id normal, no el «[HACKATHON]»)
BASETEN_MODEL=
# Opcional (pruebas con un servidor falso). Por defecto: https://inference.baseten.co/v1
BASETEN_BASE_URL=
# 1 = agente con IA activo. Cualquier otro valor (o sin definir) = apagado: 503 y modo sin IA.
AGENTE_ACTIVO=0
# Tope de gasto diario en dólares (por instancia de la función). 3 por defecto (si está vacío); 0 lo apaga, y un valor no válido (-1, texto) también lo apaga.
AI_DAILY_BUDGET_USD=3
# Opcional. Preguntas con IA por visitante y día (el agente está en beta). 3 por defecto; tiene que ser un entero >= 1 (0 o basura vuelven a 3 y se avisa en el arranque).
AGENTE_LIMITE_IP_DIA=3

# Dirección pública de la web (vista previa del enlace y URL canónica en index.html). Por defecto: https://donde-hace-falta.vercel.app
# Cámbiala aquí o en las variables de entorno de Vercel (VITE_URL_PUBLICA) cuando se conozca la URL final; no lleva barra final.
VITE_URL_PUBLICA=
